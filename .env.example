# Set these in Vercel (Project → Settings → Environment Variables) or .env.local for local dev.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SUPADATA_API_KEY=
# Optional: maximum spend per research run in USD (default 0.25).
RUN_CAP_USD=0.25
# Neon Postgres connection string for saved research. Without it, saved research lives in memory and is lost on restart.
DATABASE_URL=
# Password for the single-user login. Required in production: without it the deployed app refuses all requests.
APP_PASSWORD=
# Optional: monthly research budget in USD (default 20). Runs are refused once it is used up.
MONTHLY_CAP_USD=20
